{
  "$id": "https://github.com/bjoern-janson/opencore/experiments/001/archive-record-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "UPSERT"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": [
              "array",
              "boolean",
              "integer",
              "object",
              "string"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "RETIRE",
              "UNRESOLVED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "null"
          }
        }
      }
    }
  ],
  "description": "Immutable, already-durable semantic record consumed by the E001 Archive rival. This schema carries no warrant or authority decision logic.",
  "properties": {
    "commit_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "commitment_key": {
      "minLength": 1,
      "type": "string"
    },
    "content": {},
    "evidence_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "operation": {
      "enum": [
        "UPSERT",
        "RETIRE",
        "UNRESOLVED"
      ]
    },
    "parent_record_id": {
      "oneOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "record_id": {
      "description": "SHA-256 domain-separated digest of the canonical record body with record_id omitted.",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "reference_contract_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "opencore.e001.archive-record.v1"
    },
    "scope": {
      "minLength": 1,
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "type": "integer"
    },
    "warrant_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "record_id",
    "sequence",
    "scope",
    "operation",
    "commitment_key",
    "content",
    "parent_record_id",
    "evidence_digest",
    "warrant_digest",
    "commit_id",
    "receipt_id",
    "reference_contract_digest"
  ],
  "title": "OpenCore E001 Archive Record v1",
  "type": "object"
}
